# ---------------------------------------------------------------------------
# Database (Postgres via Supabase pooler)
# Used ONLY for seeding / persistence (never in --dry-run). For Vercel +
# Supabase, use the "Session pooler" connection string (port 5432).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Supabase Auth (@supabase/ssr)
# NEXT_PUBLIC_* are safe to expose to the browser; the service role key is NOT.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Server-only (admin operations). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ---------------------------------------------------------------------------
# Agent
# AGENT_MODE=offline runs the deterministic rule engine (no LLM, no network).
# AGENT_MODE=openrouter drives the same tools through OpenRouter function calling.
# ---------------------------------------------------------------------------
AGENT_MODE=offline
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# If NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are missing,
# the app runs OPEN in dev mode with a visible "auth is disabled" banner.
# ---------------------------------------------------------------------------
