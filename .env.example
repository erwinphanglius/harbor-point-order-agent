# Postgres connection used ONLY for seeding / persistence. Never used in --dry-run.
DATABASE_URL=postgres://user:pass@localhost:5432/harbor_point

# Agent mode: "offline" (deterministic, no LLM) or "openrouter" (LLM function calling).
AGENT_MODE=offline

# OpenRouter (only needed when AGENT_MODE=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
